<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Namma Nomads | Inclusive Football Community</title>
     <!-- Browser tab icon -->
    <link rel="icon" type="image/png" href="/images/browser_icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-success d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container" style="max-width: 450px;">
        <div class="card shadow-lg border-0 text-center p-5 rounded-4 bg-white">
            <!-- Green Circle with White Tick -->
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle shadow" style="width: 90px; height: 90px;">
                    <i class="fa-solid fa-check fa-3x"></i>
                </div>
            </div>

            <h3 class="fw-bold text-success mb-2">Payment Successful!</h3>
            <p class="text-muted mb-4">Your slot has been successfully confirmed.</p>

            <% if (typeof game !== 'undefined' && game && game.title) { %>
                <div class="bg-light p-3 rounded-3 text-start mb-4 border">
                    <p class="mb-1 fw-bold text-dark"><%= game.title %></p>
                    <p class="mb-1 small text-muted">📅 Date: <%= game.date %><% if (typeof game.time !== 'undefined' && game.time) { %> | ⏰ <%= game.time %><% } %></p>
                    <% if (typeof game.location !== 'undefined' && game.location) { %>
                        <p class="mb-0 small text-muted">📍 Location: <%= game.location %></p>
                    <% } %>
                </div>
            <% } %>

            <div class="d-grid gap-2">
                <a href="/my-bookings" class="btn btn-success fw-bold py-2">View My Bookings</a>
                <a href="/" class="btn btn-outline-dark fw-bold py-2">Back to Home</a>
            </div>
        </div>
    </div>
</body>
</html>