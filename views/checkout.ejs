<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/images/browser_icon.png">
    <title>Complete Booking - <%= (typeof game !== 'undefined' && game && game.title) ? game.title : 'Namma Nomads' %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="container" style="max-width: 520px;">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden p-4 p-md-5 bg-white">
            
            <!-- Timer Badge -->
            <div class="alert alert-warning border-0 d-flex align-items-center justify-content-center py-2 mb-4 rounded-pill fw-bold text-dark shadow-sm" id="timer-box" style="background-color: #fff3cd; font-size: 0.95rem;">
                <i class="fas fa-hourglass-half text-warning me-2"></i> Complete payment in:&nbsp;<span id="countdown" class="font-monospace text-danger">04:00</span>
            </div>

            <!-- Game Details -->
            <% if (typeof game !== 'undefined' && game) { %>
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark mb-3"><%= game.title || 'Match Booking' %></h3>
                    <div class="bg-light p-3 rounded-4 text-start border shadow-sm">
                        <div class="d-flex align-items-center mb-2 text-secondary">
                            <i class="fas fa-calendar-alt text-info me-3 fa-fw"></i>
                            <span><strong>Date:</strong> <%= game.date || 'TBD' %></span>
                        </div>
                        <% if (game.time) { %>
                            <div class="d-flex align-items-center mb-2 text-secondary">
                                <i class="fas fa-clock text-info me-3 fa-fw"></i>
                                <span><strong>Time:</strong> <%= game.time %></span>
                            </div>
                        <% } %>
                        <% if (game.location) { %>
                            <div class="d-flex align-items-center mb-2 text-secondary">
                                <i class="fas fa-map-marker-alt text-info me-3 fa-fw"></i>
                                <span><strong>Location:</strong> <%= game.location %></span>
                            </div>
                        <% } %>
                        <% if (game.price) { %>
                            <div class="d-flex align-items-center justify-content-between border-top pt-2 mt-2">
                                <span class="fw-bold text-dark">Amount to Pay:</span>
                                <span class="fw-bold text-success fs-5">₹<%= game.price %></span>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% } else { %>
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark mb-2">Match Booking</h3>
                    <p class="text-muted">Details unavailable.</p>
                </div>
            <% } %>

            <!-- DESKTOP QR CODE CONTAINER (Hidden until generated by clicking pay) -->
            <div id="desktop-qr-container" class="text-center mb-4" style="display: none;">
                <div class="alert alert-primary border-0 small mb-3 rounded-3 py-2">
                    <i class="fas fa-desktop me-1"></i> Scan the QR code below using PhonePe, GPay, or Paytm to pay.
                </div>
                <div class="bg-white p-3 border rounded-4 d-inline-block shadow-sm">
                    <div id="qrcode" class="d-flex justify-content-center"></div>
                </div>
                <div class="d-flex align-items-center justify-content-center mt-3 text-muted small">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    <span>Waiting for payment confirmation...</span>
                </div>
            </div>

            <!-- PAYMENT BUTTON SECTION -->
            <div id="payment-section" class="mb-3">
                <div class="alert alert-light border small mb-3 rounded-3 text-muted text-center py-2">
                    <i class="fas fa-shield-alt text-success me-1"></i> Secure payment powered by PhonePe Gateway.
                </div>
                
                <button id="phonepe-pay-btn" class="btn text-white fw-bold py-3 w-100 d-flex align-items-center justify-content-center shadow rounded-pill transition-all" style="background-color: #5f259f; font-size: 1.05rem;">
                    <i class="fas fa-bolt me-2 text-warning"></i> Pay ₹<%= (typeof game !== 'undefined' && game && game.price) ? game.price : '300' %> via PhonePe
                </button>
            </div>

            <!-- Cancel Link -->
            <div class="text-center mt-2">
                <a href="/" id="cancel-booking-btn" class="text-decoration-none small text-muted fw-semibold hover-link">
                    <i class="fas fa-arrow-left me-1"></i> Cancel / Back to Home
                </a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const gameId = "<%= (typeof game !== 'undefined' && game) ? game.id : '' %>";
            const payBtn = document.getElementById("phonepe-pay-btn");
            const desktopQrContainer = document.getElementById("desktop-qr-container");
            const paymentSection = document.getElementById("payment-section");

            // Detect if device is Desktop/Laptop
            const isDesktop = !/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

            let pollInterval = null;

            function startPaymentPolling(txId) {
                pollInterval = setInterval(async () => {
                    try {
                        const res = await fetch(`/api/phonepe/check-status?id=${txId}`);
                        const data = await res.json();
                        if (data.status === 'SUCCESS') {
                            clearInterval(pollInterval);
                            window.location.href = data.redirectUrl;
                        } else if (data.status === 'FAILED') {
                            clearInterval(pollInterval);
                            alert('Payment failed or cancelled.');
                            window.location.reload();
                        }
                    } catch (e) {
                        console.error('Polling error:', e);
                    }
                }, 3000);
            }

            // Unified click handler: Creates the order ONLY when the user clicks pay
            payBtn.onclick = async function () {
                payBtn.disabled = true;
                payBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Initializing Secure Gateway...`;

                try {
                    const response = await fetch('/api/phonepe/create-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ game_id: gameId })
                    });
                    const data = await response.json();

                    if (data.success && data.redirectUrl) {
                        if (isDesktop) {
                            // Hide button, show QR code for desktop users without saving a premature pending row
                            paymentSection.style.display = 'none';
                            desktopQrContainer.style.display = 'block';
                            document.getElementById("qrcode").innerHTML = "";
                            new QRCode(document.getElementById("qrcode"), {
                                text: data.redirectUrl,
                                width: 190,
                                height: 190
                            });
                            startPaymentPolling(data.transactionId);
                        } else {
                            // Redirect mobile users directly to the gateway
                            window.location.href = data.redirectUrl;
                        }
                    } else {
                        alert("Failed to initialize payment gateway session. Please try again.");
                        payBtn.disabled = false;
                        payBtn.innerHTML = `<i class="fas fa-bolt me-2 text-warning"></i> Pay ₹<%= (typeof game !== 'undefined' && game && game.price) ? game.price : '300' %> via PhonePe`;
                    }
                } catch (err) {
                    console.error('Payment initialization error:', err);
                    alert('An error occurred connecting to the server.');
                    payBtn.disabled = false;
                    payBtn.innerHTML = `<i class="fas fa-bolt me-2 text-warning"></i> Pay ₹<%= (typeof game !== 'undefined' && game && game.price) ? game.price : '300' %> via PhonePe`;
                }
            };

            // Countdown Timer (4 minutes)
            let timeLeft = 240;
            const countdownEl = document.getElementById("countdown");
            const timer = setInterval(() => {
                let minutes = Math.floor(timeLeft / 60);
                let seconds = timeLeft % 60;
                if (countdownEl) {
                    countdownEl.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                }
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    if (pollInterval) clearInterval(pollInterval);
                    window.location.href = "/";
                }
                timeLeft--;
            }, 1000);
        });
    </script>
</body>
</html>