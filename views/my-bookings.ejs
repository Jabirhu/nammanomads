<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Booked Slots | Namma Nomads</title>
    <link rel="icon" type="image/png" href="/images/browser_icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="/images/logo.png" alt="Logo" width="40" height="40" class="rounded-circle me-2">
                <span>Namma Nomads</span>
            </a>
            <div class="d-flex align-items-center">
                <a href="/" class="btn btn-outline-dark btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Back to Home
                </a>
            </div>
        </div>
    </nav>
    <div class="container my-5 pt-5" style="max-width: 700px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-dark mb-0"><i class="fas fa-ticket-alt me-2" style="color: var(--primary);"></i>My Booked Slots</h2>
        </div>
        <% if (typeof bookings === 'undefined' || !bookings || bookings.length === 0) { %>
            <div class="card shadow-sm border-0 rounded-4 text-center p-5 bg-white">
                <div class="mb-3 text-muted opacity-50">
                    <i class="fas fa-calendar-times fa-3x"></i>
                </div>
                <h5 class="fw-bold text-dark">No Bookings Yet</h5>
                <p class="text-muted small mb-4">You haven't booked any slots yet! Explore available games and join the action.</p>
                <a href="/" class="btn btn-primary fw-bold mx-auto px-4">Browse Matches</a>
            </div>
        <% } else { %>
            <div class="list-group shadow-sm border-0 gap-3 bg-transparent">
                <% bookings.forEach(b => { %>
                    <% 
                        let statusClass = 'bg-success';
                        let currentStatus = b.status ? b.status.toLowerCase() : 'confirmed';
                        if (currentStatus === 'withdrawn') {
                            statusClass = 'bg-secondary';
                        } else if (currentStatus === 'waitlist') {
                            statusClass = 'bg-warning text-dark';
                        } else if (currentStatus === 'pending') {
                            statusClass = 'bg-success';
                        }
                    %>
                    <div class="list-group-item p-4 border-0 rounded-4 shadow-sm bg-white position-relative">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="fw-bold text-dark mb-0"><%= b.title || 'Match Booking' %></h4>
                            <div class="d-flex align-items-center gap-2">
                                <% if (currentStatus === 'pending') { %>
                                    <button type="button" class="badge <%= statusClass %> px-3 py-2 text-uppercase fw-bold border-0 shadow-sm" style="cursor: pointer;" onclick="
                                        event.preventDefault(); 
                                        event.stopPropagation();
                                        
                                        let pendingModalEl = document.getElementById('pendingModal<%= b.game_id %>');
                                        if (!pendingModalEl) {
                                            const pendingModalHTML = `
                                            <div class='modal fade' id='pendingModal<%= b.game_id %>' tabindex='-1' aria-hidden='true'>
                                                <div class='modal-dialog modal-dialog-centered'>
                                                    <div class='modal-content border-0 rounded-4 shadow'>
                                                        <div class='modal-header border-0 pb-0'>
                                                            <h5 class='modal-title fw-bold text-dark'><i class='fas fa-clock text-warning me-2'></i>Pending Payment</h5>
                                                            <button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close'></button>
                                                        </div>
                                                        <div class='modal-body px-4 py-3'>
                                                            <p class='text-muted mb-4'>
                                                                Do you want to proceed for pending payment or left payment for <strong><%= b.title || 'Match Booking' %></strong>?
                                                            </p>
                                                            <a href='/book/<%= b.game_id %>' class='btn w-100 fw-bold py-2 text-dark shadow-sm' style='background-color: #ffc107; border-color: #ffc107;'>
                                                                Proceed to Pending Payment
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>`;
                                            document.body.insertAdjacentHTML('beforeend', pendingModalHTML);
                                            pendingModalEl = document.getElementById('pendingModal<%= b.game_id %>');
                                        }
                                        
                                        const myPendingModal = new bootstrap.Modal(pendingModalEl);
                                        myPendingModal.show();
                                    ">
                                        <%= b.status || 'Confirmed' %>
                                    </button>
                                <% } else { %>
                                    <span class="badge <%= statusClass %> px-3 py-2 text-uppercase fw-bold"><%= b.status || 'Confirmed' %></span>
                                <% } %>

                                <% if (currentStatus === 'confirmed' || currentStatus === 'waitlist' || currentStatus === 'pending') { %>
                                    <button type="button" class="btn btn-outline-danger btn-sm fw-bold px-3" data-bs-toggle="modal" data-bs-target="#withdrawModal" 
                                        data-booking-id="<%= b.id %>" 
                                        data-game-id="<%= b.game_id %>">
                                        Withdraw
                                    </button>
                                <% } %>
                            </div>
                        </div>
                        <p class="mb-1 text-muted small mt-2">
                            <i class="fas fa-calendar-alt me-1 text-primary"></i> <strong>Date:</strong> <%= b.date || 'TBD' %> &nbsp;|&nbsp; 
                            <i class="fas fa-clock me-1 text-primary"></i> <strong>Time:</strong> <%= b.time || 'TBD' %>
                        </p>
                        <% if (b.location) { %>
                            <p class="mb-1 text-muted small">
                                <i class="fas fa-map-marker-alt me-1 text-danger"></i> <strong>Location:</strong> <%= b.location %>
                            </p>
                        <% } %>
                        <% if (b.price) { %>
                            <p class="mb-1 fw-bold small" style="color: var(--success);">
                                <i class="fas fa-rupee-sign me-1"></i> Paid: ₹<%= b.price %>
                            </p>
                        <% } %>
                        <% if (b.created_at) { %>
                            <small class="text-muted d-block mt-2 opacity-75" style="font-size: 0.75rem;">
                                <i class="fas fa-history me-1"></i> Action Timestamp: <%= b.created_at %>
                            </small>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
    <div class="modal fade" id="withdrawModal" tabindex="-1" aria-labelledby="withdrawModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <form action="/withdraw" method="POST">
                    <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                        <h5 class="modal-title fw-bold text-dark" id="withdrawModalLabel">Reason for Withdrawal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body px-4 py-3">
                        <input type="hidden" name="booking_id" id="modalBookingId">
                        <input type="hidden" name="game_id" id="modalGameId">
                        <div class="mb-3">
                            <label for="reasonInput" class="form-label text-muted small fw-bold">Please provide a reason (e.g., sick, busy):</label>
                            <input type="text" name="reason" id="reasonInput" class="form-control bg-light border-0 py-2" required placeholder="Enter reason...">
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pb-4 px-4 pt-0">
                        <button type="button" class="btn btn-light btn-sm fw-bold px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm fw-bold px-3">Confirm Withdrawal</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const withdrawModal = document.getElementById('withdrawModal');
        if (withdrawModal) {
            withdrawModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (button) {
                    document.getElementById('modalBookingId').value = button.getAttribute('data-booking-id');
                    document.getElementById('modalGameId').value = button.getAttribute('data-game-id');
                }
            });
        }
    </script>
</body>
</html>