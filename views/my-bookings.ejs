<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Namma Nomads | Inclusive Football Community</title>
    <link rel="icon" type="image/png" href="/images/browser_icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 700px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">My Booked Slots</h2>
            <a href="/" class="btn btn-outline-dark btn-sm">← Back to Home</a>
        </div>

        <% if (typeof bookings === 'undefined' || !bookings || bookings.length === 0) { %>
            <div class="alert alert-info text-center p-4">You haven't booked any slots yet!</div>
        <% } else { %>
            <div class="list-group shadow-sm">
                <% bookings.forEach(b => { %>
                    <% 
                        let statusClass = 'bg-success';
                        let currentStatus = b.status ? b.status.toLowerCase() : 'confirmed';
                        if (currentStatus === 'withdrawn') {
                            statusClass = 'bg-secondary';
                        } else if (currentStatus === 'waitlist') {
                            statusClass = 'bg-warning text-dark';
                        }
                    %>
                    <div class="list-group-item p-4 mb-3 border rounded-3 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="fw-bold text-dark mb-1"><%= b.title || 'Match Booking' %></h4>
                            
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge <%= statusClass %> px-3 py-2 text-uppercase"><%= b.status || 'Confirmed' %></span>
                                
                                <% if (currentStatus === 'confirmed' || currentStatus === 'waitlist') { %>
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#withdrawModal" 
                                        data-booking-id="<%= b.id %>" 
                                        data-game-id="<%= b.game_id %>">
                                        Withdraw
                                    </button>
                                <% } %>
                            </div>
                        </div>

                        <p class="mb-1 text-muted mt-2">📅 <strong>Date:</strong> <%= b.date || 'TBD' %> | ⏰ <strong>Time:</strong> <%= b.time || 'TBD' %></p>
                        <% if (b.location) { %>
                            <p class="mb-1 text-muted">📍 <strong>Location:</strong> <%= b.location %></p>
                        <% } %>
                        <% if (b.price) { %>
                            <p class="mb-0 fw-bold text-success">Paid: ₹<%= b.price %></p>
                        <% } %>
                        <% if (b.created_at) { %>
                            <small class="text-muted d-block mt-2">Action Timestamp: <%= b.created_at %></small>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <!-- Reason Popup Modal -->
    <div class="modal fade" id="withdrawModal" tabindex="-1" aria-labelledby="withdrawModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/withdraw" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="withdrawModalLabel">Reason for Withdrawal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="booking_id" id="modalBookingId">
                        <input type="hidden" name="game_id" id="modalGameId">
                        <div class="mb-3">
                            <label for="reasonInput" class="form-label text-muted">Please provide a reason (e.g., sick, busy):</label>
                            <input type="text" name="reason" id="reasonInput" class="form-control" required placeholder="Enter reason...">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm">Confirm Withdrawal</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const withdrawModal = document.getElementById('withdrawModal');
        withdrawModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('modalBookingId').value = button.getAttribute('data-booking-id');
            document.getElementById('modalGameId').value = button.getAttribute('data-game-id');
        });
    </script>
</body>
</html>