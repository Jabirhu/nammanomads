<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Namma Nomads - Verify OTP</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="theme-background">
    <div class="card-container">
        <h2>Verify Your Email</h2>
        <p>We've sent a 6-digit verification code to your email.</p>

        <% if (locals.errorMessage) { %>
            <div class="alert alert-danger" style="color: var(--danger, #EF4444); margin-bottom: 15px; font-size: 0.9rem;">
                <%= errorMessage %>
            </div>
        <% } %>

        <form action="/verify-otp" method="POST">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" value="<%= email %>" readonly class="form-control">
            </div>

            <div class="form-group">
                <label>6-Digit OTP Code</label>
                <input type="text" name="otp" placeholder="Enter OTP" required maxlength="6" class="form-control" autocomplete="one-time-code" autofocus>
            </div>

            <button type="submit" class="btn-primary">Verify OTP</button>
        </form>

        <div class="resend-section" style="margin-top: 15px; text-align: center;">
            <button id="resendBtn" class="btn-text" type="button">Resend OTP</button>
            <span id="resendStatus" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
        </div>
    </div>

    <script>
        document.getElementById('resendBtn').addEventListener('click', async () => {
            const email = "<%= email %>";
            const statusSpan = document.getElementById('resendStatus');
            statusSpan.className = "text-warning";
            statusSpan.style.color = "var(--warning, #F59E0B)";
            statusSpan.innerText = "Sending...";

            try {
                const response = await fetch('/resend-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await response.json();
                if (data.success) {
                    statusSpan.className = "text-success";
                    statusSpan.style.color = "var(--success, #10B981)";
                    statusSpan.innerText = "OTP resent successfully!";
                } else {
                    statusSpan.className = "text-error";
                    statusSpan.style.color = "var(--danger, #EF4444)";
                    statusSpan.innerText = data.message || "Error resending OTP.";
                }
            } catch (err) {
                statusSpan.className = "text-error";
                statusSpan.style.color = "var(--danger, #EF4444)";
                statusSpan.innerText = "Server error while resending OTP.";
            }
        });
    </script>
</body>
</html>