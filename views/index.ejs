<!-- ========================================================================= -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Namma Nomads | Inclusive Football Community</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!--font awesome-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- External Custom Stylesheet -->
    <link rel="stylesheet" href="/style.css">
    <!-- Browser Tab Icon -->
    <link rel="icon" type="image/png" href="/images/browser_icon.png">
</head>
<body>

    <!-- Fullscreen Loading Screen HTML -->
    <div id="page-loader">
        <div class="loader-content">
            <img src="/images/browser_icon.png" alt="Namma Nomads Logo" class="pulsing-logo">
            <div class="loader-bar"></div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- NAVIGATION BAR SECTION                                                -->
    <!-- ===================================================================== -->
    <nav class="navbar navbar-expand-lg navbar-light glass-nav sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="/images/browser_icon.png" alt="Namma Nomads Logo" style="width: 32px; height: 32px; object-fit: cover; margin-right: 10px; border-radius: 50%;">
                <span>Namma Nomads</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="#games">Games</a></li>
                    <li class="nav-item"><a class="nav-link" href="#gallery">Gallery</a></li>
                    
                    <% if (user) { %>
                         <li class="nav-item text-black btn btn-outline-light ms-3">Hello, <%= user.name %></li>
                      <% if (!(user.role === 'admin' || user.isAdmin)) { %>
                          <li class="nav-item ms-3"><a class="btn btn-outline-light btn-sm text-black" href="/my-bookings">My Bookings</a></li>
                      <% } %>
                      <% if (user.role === 'admin' || user.isAdmin) { %>
                          <li class="nav-item ms-3"><a class="btn btn-golden-metal btn-sm px-3" href="/admin/dashboard">Admin Panel</a></li>
                      <% } %>
                          <li class="nav-item ms-3"><a class="btn btn-outline-light btn-sm text-black" href="/logout">Logout</a></li>
                      <% } else { %>
                          <li class="nav-item ms-3"><button class="btn btn-sm text-white fw-bold px-3 shadow-sm" style="background-color: #0083B0; border-color: #0083B0;" data-bs-toggle="modal" data-bs-target="#authModal">Login / Register</button></li>
                      <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <!-- ===================================================================== -->
    <!-- END OF NAVIGATION BAR SECTION                                         -->
    <!-- ===================================================================== -->

    <!-- ===================================================================== -->
    <!-- HERO SECTION                                                          -->
    <!-- ===================================================================== -->
    <header class="hero-section text-white text-center py-5">
        <div class="container py-4">
            <img src="/images/bg.png" alt="Banner" class="img-fluid mb-4 rounded shadow" style="max-height: 180px; object-fit: cover;">
            <h1 class="display-4 fw-bold text-dark">Play Together. Stay Together.</h1>
            <p class="lead text-secondary text-dark">Bangalore's premier co-ed football community where men and women share the pitch equally.</p>
            <a href="#games" class="btn btn-lg text-white fw-bold mt-3 shadow" style="background-color: #0083B0; border-color: #0083B0;">Book Your Slot Today</a>
        </div>
    </header>
    <!-- ===================================================================== -->
    <!-- END OF HERO SECTION                                                   -->
    <!-- ===================================================================== -->

    <!-- ===================================================================== -->
    <!-- ABOUT COMMUNITY SECTION                                               -->
    <!-- ===================================================================== -->
    <section id="about" class="py-5 bg-light">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 mb-4 mb-md-0">
                    <h2 class="fw-bold" style="color: #0083B0;">About Namma Nomads</h2>
                    <p class="mt-3">Namma Nomads is more than just a football group—it's an inclusive community built for passionate players of all backgrounds. We break barriers by hosting mixed-gender co-ed football matches where both men and women play together on the same field with high sportsmanship, mutual respect, and competitive fun.</p>
                </div>
                <div class="col-md-6 text-center">
                    <div class="p-4 bg-white shadow rounded border">
                        <h4 class="fw-bold" style="color: #0083B0;">Core Community Values</h4>
                        <ul class="list-unstyled mt-3 text-start">
                            <li class="mb-2">⚽ Inclusive Co-Ed Play for Men & Women</li>
                            <li class="mb-2">🤝 Respect, Safety, and Fair Play on Pitch</li>
                            <li>📅 Multiple daily slots for working professionals</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- ===================================================================== -->
    <!-- END OF ABOUT COMMUNITY SECTION                                        -->
    <!-- ===================================================================== -->

    <!-- ===================================================================== -->
    <!-- GAMES SCHEDULE & BOOKING SECTION                                      -->
    <!-- ===================================================================== -->
    <section id="games" class="py-5">
        <div class="container">
            <h2 class="text-center fw-bold mb-4" style="color: #0083B0;">Upcoming Games & Schedule</h2>
            <div class="row">
                <% if(games.length === 0) { %>
                    <p class="text-center text-muted">No games scheduled right now. Check back soon!</p>
                <% } %>
                <% games.forEach(game => { %>
                    <% 
                      const remainingSlots = Math.max(0, Number(game.slots || 0) - Number(game.registeredCount || 0));
                      const existingStatus = (typeof userBookings !== 'undefined' && user) ? userBookings[game.id] : null;
                    %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow border-0 p-3 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h4 class="fw-bold text-dark mb-0"><%= game.title %></h4>
                                    <span class="badge rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                                          style="width: 36px; height: 36px; font-size: 0.85rem;" 
                                          title="Remaining Slots">
                                        <%= remainingSlots %>
                                    </span>
                                </div>
                                <p class="mb-1 text-muted">📅 Date: <%= new Date(game.date).toLocaleDateString('en-GB') %></p>
                                <p class="mb-1 text-muted">⏰ Time: <%= game.time %></p>
                                <p class="mb-1 text-muted">📍 Location: <%= game.location %></p>    
                                <p class="mb-3 text-muted">💰 Price: ₹<%= game.price %></p>
                            </div>
                            
                            <!-- Card Actions -->
                            <% if (existingStatus) { %>
                                <button type="button" class="btn btn-outline-secondary w-100 fw-bold py-2" data-bs-toggle="modal" data-bs-target="#alreadyBookedModal<%= game.id %>">
                                    <%= existingStatus === 'Waiting List' ? 'On Waiting List' : 'Already Booked' %>
                                </button>
                            
                                <div class="modal fade" id="alreadyBookedModal<%= game.id %>" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 rounded-4 shadow">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold text-info"><i class="fas fa-info-circle me-2"></i>Booking Status</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body px-4 py-3">
                                                <p class="text-muted mb-3">
                                                    You already have an active entry for <strong><%= game.title %></strong>. 
                                                    Your current status is: <strong class="text-dark"><%= existingStatus %></strong>.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            
                            <% } else if (remainingSlots === 0) { %>
                                <button type="button" 
                                        class="btn w-100 fw-bold login-trigger-btn py-2 text-white shadow-sm" 
                                        style="background-color: #0083B0; border-color: #0083B0;"
                                        data-logged-in="<%= user ? 'true' : 'false' %>"
                                        <% if (user) { %> data-bs-toggle="modal" data-bs-target="#waitingListModal<%= game.id %>" <% } %>>
                                    <%= user ? 'Book Now' : 'Login to Book' %>
                                </button>
                            
                                <% if (user) { %>
                                <div class="modal fade" id="waitingListModal<%= game.id %>" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 rounded-4 shadow">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold text-danger"><i class="fas fa-exclamation-circle me-2"></i>Slots Full</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body px-4 py-3">
                                                <p class="text-muted mb-4">All available slots for <strong><%= game.title %></strong> are currently filled. If you proceed, you will be placed on the <strong>waiting list</strong>.</p>
                                                <form action="/book/<%= game.id %>" method="GET">
                                                    <input type="hidden" name="status" value="Waiting List">
                                                    <button type="submit" class="btn w-100 fw-bold py-2 text-white shadow-sm" style="background-color: #0083B0; border-color: #0083B0;">
                                                        Proceed to Waiting List
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                            
                            <% } else { %>
                                <a href="/book/<%= game.id %>" 
                                   class="btn w-100 fw-bold login-trigger-btn py-2 text-white shadow-sm"
                                   style="background-color: #0083B0; border-color: #0083B0;"
                                   data-logged-in="<%= user ? 'true' : 'false' %>">
                                    <%= user ? 'Book Now' : 'Login to Book' %>
                                </a>
                            <% } %>
                                                        
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>
    <!-- ===================================================================== -->
    <!-- END OF GAMES SCHEDULE SECTION                                         -->
    <!-- ===================================================================== -->

    <!-- ===================================================================== -->
    <!-- PHOTO GALLERY SECTION                                                 -->
    <!-- ===================================================================== -->
    <section id="gallery" class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center fw-bold mb-4" style="color: #0083B0;">Photo Gallery</h2>
            <div class="row">
                <% if (gallery && gallery.length > 0) { %>
                    <% gallery.forEach(item => { %>
                        <div class="col-md-4 mb-3">
                            <img src="<%= item.image_url %>" class="img-fluid rounded shadow w-100" style="height: 220px; object-fit: cover;" alt="Gallery">
                            <p class="text-center text-muted small mt-2"><%= item.caption %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-md-4 mb-3"><img src="/images/gal1.png" class="img-fluid rounded shadow w-100" style="height: 220px; object-fit: cover;" alt="Gallery"></div>
                    <div class="col-md-4 mb-3"><img src="/images/gal2.png" class="img-fluid rounded shadow w-100" style="height: 220px; object-fit: cover;" alt="Gallery"></div>
                    <div class="col-md-4 mb-3"><img src="/images/gal3.png" class="img-fluid rounded shadow w-100" style="height: 220px; object-fit: cover;" alt="Gallery"></div>
                <% } %>
            </div>
        </div>
    </section>
    <!-- ===================================================================== -->
    <!-- END OF PHOTO GALLERY SECTION                                          -->
    <!-- ===================================================================== -->

    <!-- ===================================================================== -->
    <!-- SPLIT-SCREEN LOGIN / REGISTER MODAL SECTION                           -->
    <!-- ===================================================================== -->
    <div class="modal fade" id="authModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content border-0 overflow-hidden shadow-lg">
                <div class="row g-0"> 
                    <!-- Left Side: Forms -->
                    <div class="col-lg-6 p-5 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Top Tabs -->
                            <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                                <span class="fw-bold fs-5 text-dark cursor-pointer" id="login-tab-btn">Login</span>
                                <span class="mx-2 text-muted">/</span>
                                <span class="fw-bold fs-5 text-muted cursor-pointer" id="register-tab-btn">Register</span>
                                <span class="mx-2 text-muted">/</span>
                                <span class="fw-bold fs-5 text-muted cursor-pointer" id="admin-tab-btn">Admin</span>
                            </div>
                    
                            <!-- Login Form -->
                            <div id="loginPane" class="auth-pane">
                                <h2 class="fw-bold mb-2">Welcome back</h2>
                                <p class="text-muted small mb-4">Please enter your details to sign in.</p>
                                <form action="/login" method="POST">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-semibold">Mobile Number</label>
                                        <input type="text" class="form-control" name="mobile" required>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label text-muted small fw-semibold">Password</label>
                                        <input type="password" class="form-control" name="password" required>
                                    </div>
                                    <button type="submit" class="btn w-100 py-2 fw-bold text-white shadow-sm" style="background-color: #0083B0; border-color: #0083B0;">Login</button>
                                </form>
                            </div>
                    
                            <!-- Register Form -->
                            <div id="signupPane" class="auth-pane d-none">
                                <h2 class="fw-bold mb-2">Create Account</h2>
                                <p class="text-muted small mb-4">Please enter your details to sign up.</p>
                                <form id="registerForm" action="/signup" method="POST">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-semibold">Full Name</label>
                                        <input type="text" class="form-control" name="name" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-semibold">Email Address</label>
                                        <input type="email" class="form-control" name="email" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-semibold">Mobile Number</label>
                                        <input type="text" class="form-control" name="mobile" pattern="[0-9]{10}" title="Please enter a valid 10-digit mobile number" required>
                                    </div>

                                    <div class="mb-3"> 
                                        <label for="registerPassword" class="form-label text-muted small fw-semibold">Password</label> 
                                        <div class="password-wrapper"> 
                                            <input type="password" class="form-control" id="registerPassword" name="password" minlength="6" autocomplete="new-password" required> 
                                            <button type="button" class="toggle-password" data-target="registerPassword" aria-label="Show password" title="Show password"><i class="bi bi-eye-slash"></i></button> 
                                        </div> 
                                        <div class="form-text text-muted" style="font-size: 0.75rem;">Must be at least 6 characters long.</div>
                                    </div> 

                                    <div class="mb-4"> 
                                        <label for="confirmPassword" class="form-label text-muted small fw-semibold">Confirm Password</label> 
                                        <div class="password-wrapper"> 
                                            <input type="password" class="form-control" id="confirmPassword" autocomplete="new-password" required> 
                                            <button type="button" class="toggle-password" data-target="confirmPassword" aria-label="Show password" title="Show password"><i class="bi bi-eye-slash"></i></button> 
                                        </div> 
                                    </div>
                                    
                                    <div id="registerError" class="alert alert-danger d-none py-2 small mb-3" role="alert"></div>

                                    <button type="submit" class="btn w-100 py-2 fw-bold text-white shadow-sm" style="background-color: #0083B0; border-color: #0083B0;">Register</button>
                                </form>
                            </div>
                    
                            <!-- Admin Login Form -->
                            <div id="adminPane" class="auth-pane d-none">
                                <h2 class="fw-bold mb-2">Admin Portal</h2>
                                <p class="text-muted small mb-4">Restricted access for administrators only.</p>
                                <form action="/login" method="POST">
                                    <input type="hidden" name="is_admin_form" value="true">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-semibold">Admin Mobile</label>
                                        <input type="text" class="form-control" name="mobile" value="9353863794" required>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label text-muted small fw-semibold">Admin Password</label>
                                        <input type="password" class="form-control" name="password" required>
                                    </div>
                                    <button type="submit" class="btn btn-golden-metal w-100 py-2 shadow">Login as Admin</button>
                                </form>
                            </div>
                        </div>
                    
                        <!-- Modal Footer -->
                        <div class="d-flex justify-content-between text-muted small pt-3 border-top">
                            <span>&copy; 2026 Namma Nomads</span>
                            <span>support@nammamnomads.com</span>
                        </div>
                    </div>
                    <!-- Right Side: Brand Image Panel -->
                    <div class="col-lg-6 d-none d-lg-flex bg-dark align-items-center justify-content-center p-5 position-relative overflow-hidden" style="isolation: isolate;">
                        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('/images/gal5.png') center/cover no-repeat; filter: blur(4px); opacity: 0.35; transform: scale(1.1); z-index: 0;"></div>
                        
                        <div class="position-absolute top-0 end-0 p-3" style="z-index: 3;">
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="text-center position-relative" style="z-index: 2;">
                            <img src="/images/logo.png" alt="Namma Nomads Logo" class="img-fluid rounded-circle shadow-lg mb-4 border border-3 bg-dark" style="max-width: 180px; height: 180px; object-fit: cover; border-color: #0083B0 !important;">
                            <h3 class="text-white fw-bold">Namma Nomads</h3>
                            <p class="text-white-50 px-4">Bangalore's premier inclusive co-ed football community.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ===================================================================== -->
    <!-- END OF SPLIT-SCREEN MODAL SECTION                                     -->
    <!-- ===================================================================== -->

    <!-- ===================================================================== -->
    <!-- STARTOF MOBILE BOTTOM NAVIGATION BAR                                  -->
    <!-- ===================================================================== -->
    <nav class="navbar fixed-bottom bg-white border-top shadow-lg d-md-none py-2 px-3 rounded-top-4">
        <div class="container-fluid d-flex justify-content-around align-items-center">
            <a href="/" class="text-decoration-none text-center text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-house-fill mb-1 d-block mx-auto" viewBox="0 0 16 16">
                    <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V135A1.5 1.5 0 0 0 3.5 14.5h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"/>
                </svg>
                <span style="font-size: 0.7rem; font-weight: 600;">Home</span>
            </a>
            <a href="/#book-section" class="text-decoration-none text-center text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-calendar-check-fill mb-1 d-block mx-auto" viewBox="0 0 16 16">
                    <path d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v1h16V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4zM16 14V5H0v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2m-5.146-5.146-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L7.5 10.793l2.646-2.647a.5.5 0 0 1 .708.708"/>
                </svg>
                <span style="font-size: 0.7rem; font-weight: 600;">Bookings</span>
            </a>
            <a href="/my-bookings" class="text-decoration-none text-center" style="color: #0083B0;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-circle-fill mb-1 d-block mx-auto" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                    <path fill="#fff" d="M8 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8M5.5 6.5l2-1.5h1l2 1.5-1 2.5h-2z"/>
                </svg>
                <span style="font-size: 0.7rem; font-weight: 600;">My Matches</span>
            </a>
            <a href="#" class="text-decoration-none text-center text-muted" data-bs-toggle="modal" data-bs-target="#profileModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-person-fill mb-1 d-block mx-auto" viewBox="0 0 16 16">
                    <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                </svg>
                <span style="font-size: 0.7rem; font-weight: 600;">Profile</span>
            </a>
        </div>
    </nav>
    <!-- ===================================================================== -->
    <!-- END OF MOBILE BOTTOM NAVIGATION BAR                                   -->
    <!-- ===================================================================== -->


    <footer class="bg-dark text-white text-center py-3">
        <p class="mb-0">&copy; 2026 Namma Nomads Football Community. All rights reserved.</p>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    /* =========================================================
       PAGE LOADER
    ========================================================= */
    window.addEventListener('load', () => {
        setTimeout(() => {
            document.body.classList.add('loaded');
        }, 400);
    });

    /* =========================================================
       PAGE INTERACTIONS
    ========================================================= */
    document.addEventListener('DOMContentLoaded', () => {

        /* -----------------------------------------------------
           LOGIN / REGISTER / ADMIN TAB SWITCHING
        ----------------------------------------------------- */
        const loginTabBtn = document.getElementById('login-tab-btn');
        const registerTabBtn = document.getElementById('register-tab-btn');
        const adminTabBtn = document.getElementById('admin-tab-btn');

        const loginPane = document.getElementById('loginPane');
        const signupPane = document.getElementById('signupPane');
        const adminPane = document.getElementById('adminPane');

        function setActiveTab(activeButton, activePane) {
            const tabButtons = [loginTabBtn, registerTabBtn, adminTabBtn].filter(Boolean);
            const panes = [loginPane, signupPane, adminPane].filter(Boolean);

            tabButtons.forEach(button => {
                button.classList.remove('text-dark', 'fw-bold');
                button.classList.add('text-muted');
            });

            panes.forEach(pane => {
                pane.classList.add('d-none');
            });

            activeButton.classList.remove('text-muted');
            activeButton.classList.add('text-dark', 'fw-bold');
            activePane.classList.remove('d-none');
        }

        if (loginTabBtn && loginPane) {
            loginTabBtn.addEventListener('click', () => setActiveTab(loginTabBtn, loginPane));
        }

        if (registerTabBtn && signupPane) {
            registerTabBtn.addEventListener('click', () => setActiveTab(registerTabBtn, signupPane));
        }

        if (adminTabBtn && adminPane) {
            adminTabBtn.addEventListener('click', () => setActiveTab(adminTabBtn, adminPane));
        }

        /* -----------------------------------------------------
           AUTO-OPEN LOGIN MODAL AFTER SIGN-UP
        ----------------------------------------------------- */
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('login') === 'open') {
            const modalElement = document.getElementById('authModal');
            if (modalElement) {
                const authModal = bootstrap.Modal.getOrCreateInstance(modalElement);
                authModal.show();
            }
        }

        /* -----------------------------------------------------
           LOGIN INTERCEPTOR FOR BOOKING BUTTONS
        ----------------------------------------------------- */
        const loginButtons = document.querySelectorAll('.login-trigger-btn');
        loginButtons.forEach(button => {
            button.addEventListener('click', event => {
                const isLoggedIn = button.getAttribute('data-logged-in') === 'true';
                if (!isLoggedIn) {
                    event.preventDefault();
                    const modalElement = document.getElementById('authModal');
                    if (modalElement) {
                        const authModal = bootstrap.Modal.getOrCreateInstance(modalElement);
                        authModal.show();
                    }
                }
            });
        });

        /* -----------------------------------------------------
           PASSWORD VISIBILITY TOGGLE
        ----------------------------------------------------- */
        const passwordToggleButtons = document.querySelectorAll('.toggle-password');
        passwordToggleButtons.forEach(button => {
            button.addEventListener('click', () => {
                const targetId = button.dataset.target;
                const input = document.getElementById(targetId);
                const icon = button.querySelector('i');
            
                if (!input || !icon) return;
            
                const passwordIsHidden = input.type === 'password';
            
                if (passwordIsHidden) {
                    input.type = 'text';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                    button.setAttribute('aria-label', 'Hide password');
                    button.setAttribute('title', 'Hide password');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                    button.setAttribute('aria-label', 'Show password');
                    button.setAttribute('title', 'Show password');
                }
            });
        });

        /* -----------------------------------------------------
           REGISTRATION FORM VALIDATION
        ----------------------------------------------------- */
        const registerForm = document.getElementById('registerForm');
        const password = document.getElementById('registerPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const errorAlert = document.getElementById('registerError');

        if (registerForm && password && confirmPassword && errorAlert) {
            registerForm.addEventListener('submit', event => {
                errorAlert.classList.add('d-none');
                errorAlert.textContent = '';

                if (password.value.length < 6) {
                    event.preventDefault();
                    errorAlert.textContent = 'Password must be at least 6 characters long.';
                    errorAlert.classList.remove('d-none');
                    password.focus();
                    return;
                }

                if (password.value !== confirmPassword.value) {
                    event.preventDefault();
                    errorAlert.textContent = 'Passwords do not match. Please check and try again.';
                    errorAlert.classList.remove('d-none');
                    confirmPassword.focus();
                }
            });
        }

    });
    </script>

</body>
</html>
